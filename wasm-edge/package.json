{
  "name": "recached-edge",
  "description": "Browser and edge WebAssembly client for Recached \u2014 zero-latency local cache with automatic server sync",
  "version": "0.1.7",
  "type": "module",
  "main": "sdk.js",
  "module": "sdk.js",
  "types": "sdk.d.ts",
  "exports": {
    ".": {
      "types": "./sdk.d.ts",
      "import": "./sdk.js",
      "default": "./sdk.js"
    }
  },
  "files": [
    "sdk.js",
    "sdk.d.ts",
    "sdk.d.ts.map",
    "pkg/"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg && tsc",
    "typecheck": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkgrid-labs/recached"
  },
  "homepage": "https://github.com/thinkgrid-labs/recached",
  "bugs": "https://github.com/thinkgrid-labs/recached/issues",
  "keywords": [
    "cache",
    "wasm",
    "webassembly",
    "redis",
    "redis-compatible",
    "local-first",
    "offline-first",
    "edge",
    "websocket",
    "indexeddb",
    "typescript",
    "real-time",
    "in-memory",
    "browser-cache",
    "zero-latency"
  ],
  "license": "MIT",
  "licenseFile": "../LICENSE.md"
}
