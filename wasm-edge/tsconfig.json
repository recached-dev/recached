{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    // ESNext.Disposable: wasm-bindgen 0.2.120 emits `[Symbol.dispose](): void`
    // on the generated class, which ES2020's lib does not know about.
    "lib": ["ES2020", "DOM", "ESNext.Disposable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": ".",
    "rootDir": "."
  },
  "include": ["sdk.ts"],
  "exclude": ["node_modules"]
}
